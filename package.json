{
  "name": "profile-editor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web --",
    "build": "npm run build -w packages/userscript && npm run build -w apps/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/userscript && tsc -p apps/web && tsc -p api",
    "lint": "eslint .",
    "e2e": "node scripts/e2e/showcase.mjs",
    "e2e:kit": "node scripts/e2e/kit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
